{
  "name": "@polylib/polylib-js",
  "version": "0.1.0",
  "private": false,
  "license": "MIT",
  "type": "module",
  "description": "Native Node.js and Bun TypeScript library powered by polylib-core via napi-rs.",
  "homepage": "https://github.com/your-org/polyglot-lib-template#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/your-org/polyglot-lib-template.git",
    "directory": "packages/polylib-js"
  },
  "bugs": {
    "url": "https://github.com/your-org/polyglot-lib-template/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "napi": {
    "binaryName": "polylib",
    "packageName": "@polylib/polylib-js",
    "targets": [
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-musl",
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-pc-windows-msvc",
      "aarch64-pc-windows-msvc"
    ],
    "npmDir": "npm"
  },
  "sideEffects": false,
  "engines": {
    "bun": ">=1.1.0",
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build:native": "napi build --platform --release --manifest-path ../../crates/polylib-js/Cargo.toml --js binding.cjs --dts binding.d.ts --output-dir ./src/native -- --locked",
    "dev": "bunup --watch",
    "build": "bunup",
    "prepack": "bun run build",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "devDependencies": {
    "@aboviq/bun-test-cucumber": "0.2.0",
    "@archont561/bun-test-utils": "0.2.0",
    "@arethetypeswrong/cli": "0.18.5",
    "@napi-rs/cli": "3.9.0",
    "bunup": "0.16.32",
    "fast-check": "4.10.2",
    "publint": "0.3.25"
  },
  "optionalDependencies": {
    "@polylib/polylib-js-linux-x64-gnu": "0.1.0",
    "@polylib/polylib-js-linux-arm64-gnu": "0.1.0",
    "@polylib/polylib-js-linux-x64-musl": "0.1.0",
    "@polylib/polylib-js-linux-arm64-musl": "0.1.0",
    "@polylib/polylib-js-darwin-x64": "0.1.0",
    "@polylib/polylib-js-darwin-arm64": "0.1.0",
    "@polylib/polylib-js-win32-x64-msvc": "0.1.0",
    "@polylib/polylib-js-win32-arm64-msvc": "0.1.0"
  }
}
