{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["package", "lints"],
  "properties": {
    "package": {
      "type": "object",
      "required": ["name", "version", "edition", "rust-version", "license"],
      "properties": {
        "version": {
          "type": "object",
          "required": ["workspace"],
          "properties": { "workspace": { "const": true } }
        },
        "edition": {
          "type": "object",
          "required": ["workspace"],
          "properties": { "workspace": { "const": true } }
        },
        "rust-version": {
          "type": "object",
          "required": ["workspace"],
          "properties": { "workspace": { "const": true } }
        },
        "license": {
          "type": "object",
          "required": ["workspace"],
          "properties": { "workspace": { "const": true } }
        }
      }
    },
    "lints": {
      "type": "object",
      "required": ["workspace"],
      "properties": { "workspace": { "const": true } }
    }
  }
}
