{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["build-system", "project", "tool"],
  "properties": {
    "build-system": {
      "type": "object",
      "required": ["requires", "build-backend"],
      "properties": {
        "build-backend": { "const": "maturin" }
      }
    },
    "project": {
      "type": "object",
      "required": ["name", "version", "requires-python", "license"],
      "properties": {
        "requires-python": { "type": "string", "pattern": "^>=3\\.1[0-9]$" }
      }
    },
    "tool": {
      "type": "object",
      "required": ["maturin"],
      "properties": {
        "maturin": {
          "type": "object",
          "required": ["manifest-path", "python-source", "module-name", "features"],
          "properties": {
            "features": {
              "type": "array",
              "contains": { "const": "extension-module" }
            }
          }
        }
      }
    }
  }
}
