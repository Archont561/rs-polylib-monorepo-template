{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["name", "version", "license", "type", "exports"],
  "properties": {
    "name": { "type": "string", "pattern": "^@polylib/[a-z0-9-]+$" },
    "license": { "const": "MIT" },
    "type": { "const": "module" },
    "exports": { "type": "object", "minProperties": 1 }
  }
}
