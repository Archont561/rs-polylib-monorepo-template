      "properties": { "style": { "const": "dash" } }
    },
    "MD049": {
      "type": "object",
      "required": ["style"],
      "properties": { "style": { "const": "asterisk" } }
    },
    "MD050": {
      "type": "object",
      "required": ["style"],
      "properties": { "style": { "const": "asterisk" } }
    }
  }
}
